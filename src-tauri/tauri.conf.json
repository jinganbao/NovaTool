{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaTool",
  "version": "1.0.2",
  "identifier": "com.sunshine.NovaTool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NovaTool",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNzRERTE1NUU1RDU1ODMKUldTRFZWMWVGZDUwS3YvYnExL0VLNVV4N1YwaHZzS3JmQXdQaU8rWnZOUGlwM3FnZDF5TFAwNjAK",
      "endpoints": [
        "https://github.com/jinganbao/NovaTool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
